#!/usr/bin/env bash
# bin/detect BUILD_DIR

BUILD_DIR=$1

if [ -f "$BUILD_DIR/Aptfile" ] || [ "$STACK" = "heroku-18" ] || [ "$STACK" = "heroku-20" ] || [ "$STACK" = "heroku-22" ] || [ "$STACK" = "heroku-24" ] || [ "$STACK" = "heroku-26" ]; then
    echo "wkhtmltopdf"
else
    echo "ERROR: wkhtmltopdf supports heroku-18, heroku-20, heroku-22, heroku-24, and heroku-26 stacks."
    exit 1
fi
